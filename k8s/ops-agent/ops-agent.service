[Unit]
Description=운영 제어 에이전트 (관리자 페이지 버튼 → Arda 켜기·끄기, Ollama 모델 올리기·내리기)
After=network-online.target docker.service

[Service]
Type=simple
EnvironmentFile=%h/.config/ops-agent/env
ExecStart=/usr/bin/python3 %h/.local/lib/ops-agent/ops_agent.py
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
