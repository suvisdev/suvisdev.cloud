# 이 파일을 복사해 `.env`로 저장한 뒤 값을 채우세요. (`.env`는 Git에 올리지 마세요.)

# Neon 등 PostgreSQL 비동기 연결 문자열
# Neon Dashboard → Connection string 복사 (비밀번호 변경 시 전체 문자열 교체)
# 예: postgresql+psycopg://USER:PASSWORD@HOST/neondb?sslmode=require
# channel_binding=require 는 넣지 마세요 (psycopg 비동기 호환 문제)
# Mova 영화 DB (Neon)
MOVA_DATABASE_URL=
# 동일 URL을 쓸 때는 DATABASE_URL 만 있어도 됨
DATABASE_URL=

# --- 로컬 Docker PostgreSQL + pgvector (contents 앱 등) ---
# docker-compose.yaml의 db 서비스 인증 정보로 그대로 주입됨.
# 실행: docker compose --env-file suvisdev/.env up -d db
# DATABASE_URL을 로컬 컨테이너로 돌릴 때 예시:
# postgresql+psycopg://USER:PASSWORD@localhost:5432/DBNAME
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
# 호스트 5432 포트가 이미 사용 중이면 변경
DB_PORT=5432

# pgAdmin(http://localhost:5050) 로그인 — 비우면 admin@admin.com / admin 기본값 사용
# (pgAdmin이 이메일 형식을 검증해 .local 등 예약 도메인은 거부함)
PGADMIN_DEFAULT_EMAIL=
PGADMIN_DEFAULT_PASSWORD=

# Secom 회원 DB (Neon) — 비우면 MOVA/DATABASE_URL 과 동일 DB 사용
SECOM_DATABASE_URL=

# Google Gemini API 키 — https://aistudio.google.com/apikey
GEMINI_API_KEY=

# (선택) 기본 모델 ID. 구형 gemini-1.5-* / 2.0 / 2.5 는 자동으로 3.1로 대체됩니다.
# 프론트: flash → gemini-3.1-flash-lite, flash15 → gemini-3.1-flash-lite, pro → gemini-3.1-pro-preview
# GEMINI_MODEL=gemini-3.1-flash-lite

# TMDB(The Movie Database) — https://www.themoviedb.org/settings/api
# 인기 영화·검색 데이터를 Mova DB에 적재 (서버 기동 시 영화 5편 미만이면 자동 시드)
# ontology harvester의 tmdb 어댑터도 동일 키를 사용
TMDB_API_KEY=

# KOFIC(KOBIS) 오픈 API — http://www.kobis.or.kr/kobisopenapi/homepg/main/main.do
# 일간/주간 박스오피스를 Mova DB/HOT 랭킹으로 반영할 때 사용
# ontology harvester의 kobis 어댑터·동적 키워드 소스도 동일 키를 사용
KOFIC_API_KEY=

# Neo4j Graph DB 비밀번호 — 반드시 8자 이상
NEO4J_PASSWORD=

# --- AWS S3 (IAM 사용자 액세스 키) ---
# IAM 콘솔 → 사용자 → 보안 자격 증명 → 액세스 키 만들기(프로그래밍 방식 액세스).
# 루트 계정 키 대신 최소 권한(해당 버킷 s3:ListBucket/GetObject/PutObject 등)만
# 부여한 IAM 사용자 키를 쓸 것. 이 키는 절대 커밋 금지(.env만, .env.example 아님).
# S3 접근은 Tank(core/matrix/aws_tank_s3_manager.py)로 단일화 — Tank는 boto3 기본
# 자격증명 체인을 쓴다. 로컬/온프레미스에선 아래 두 키를 채우면 되고, EC2 배포 시엔
# 인스턴스 IAM Role이 자격증명을 주입하므로 아래 두 키를 비워도 된다.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# S3 리전 (서울=ap-northeast-2). 비우면 ap-northeast-2 기본값 사용.
AWS_REGION=ap-northeast-2
# 이미지/객체를 저장·조회할 기본 버킷 이름
VISION_S3_BUCKET=

# --- 로컬 소버린 AI (EXAONE) ---
# Ollama(Router/Worker exaone3.5, 임베딩용 nomic-embed-text). 기본값: http://localhost:11434
# OLLAMA_BASE_URL=

# --- hub_knowledge(RAG 벡터 검색) 임베딩 백엔드 스위치 ---
# ollama: nomic-embed-text(Ollama 필요) / gemini: Gemini API(GPU·Ollama 불필요 —
# Ollama가 없는 EC2는 이 값이어야 함). 기본값: ollama.
# EC2에서 이 값을 안 바꾸면 쿼리 임베딩이 매번 실패해 벡터 검색 경로가 통째로
# 죽고 태그 키워드 폴백만 돈다(에러 없이 조용히 — 2026-08-07 실측으로 발견).
# **주의: 두 백엔드는 의미 공간이 달라 저장된 벡터가 호환되지 않는다.** 값을
# 바꾸면 반드시 재임베딩할 것:
#   python scripts/ingest_hub_knowledge.py --embedding-backend gemini --reset
# EMBEDDING_BACKEND=ollama

# --- mova 추천 백엔드 스위치 ---
# lora: 자체 파인튜닝 모델(GPU 필요, model_servers/lora_server) / gemini: Google
# Gemini API(GPU 불필요 — GPU 없는 EC2는 이 값이어야 함). 기본값: lora.
# RECOMMENDATION_BACKEND=lora

# lora_server(GPU 서버) 위치. 코드 변경 없이 이 값만 바꾸면 원격 GPU로 붙는다.
# - 백엔드와 GPU가 같은 머신(호스트 프로세스로 기동): http://host.docker.internal:8200
# - 다른 머신(예: EC2 백엔드 + 집 GPU)의 lora_server를 Cloudflare Tunnel로 붙일 때:
#   https:// 로 노출한 터널 주소(예: https://lora.suvisdev.cloud)
# LORA_SERVER_URL=http://host.docker.internal:8200

# lora_server 인증 토큰 — 원격(터널)으로 노출할 때만 채운다(로컬 host.docker.internal
# 호출처럼 신뢰 네트워크 안이면 비워둬도 됨 — 비어있으면 헤더를 아예 안 보내고
# lora_server도 검증을 생략한다). GPU 서버 쪽 lora_server 프로세스에도 반드시
# 동일 값을 설정해야 한다. 집 GPU 서버 장애/점검 시엔 RECOMMENDATION_BACKEND=gemini로
# 바꾸고 재시작하면 즉시 Gemini로 수동 폴백된다(자동 폴백 없음 — 어떤 모델이
# 답했는지 불투명해지는 걸 막기 위한 의도적 설계).
# LORA_SERVER_TOKEN=

# n8n Dispatch 웹훅 URL (메일 발송용)
# n8n → Workflow → Webhook 노드 URL 복사
N8N_DISPATCH_WEBHOOK_URL=

# API 전체(개발자 대시보드 /docs 포함) 접근 게이트 — 비우면 게이트 비활성화(전체 공개).
# main.py의 _ApiAuthMiddleware가 사용. /api-login에서 로그인, 쿠키 7일 유지.
API_USERNAME=
API_PASSWORD=

# --- viewer OAuth 로그인 (구글/네이버/카카오) ---
# 프로바이더별 콘솔에서 Client ID/Secret 발급 후 리다이렉트 URI를
# {백엔드 URL}/viewer/oauth/{provider}/callback 형식으로 정확히 등록해야 한다.
# 값이 비어 있으면 해당 프로바이더의 /viewer/oauth/{provider}/login이 503을 반환한다(비활성화).

# Google Cloud Console → API 및 서비스 → 사용자 인증 정보 → OAuth 클라이언트 ID
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/viewer/oauth/google/callback

# Kakao Developers → 내 애플리케이션 → 카카오 로그인 (client_secret은 앱 설정에 따라 선택)
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=http://localhost:8000/viewer/oauth/kakao/callback
# mova 임베딩 크론 백필 전용 Gemini 키(두 번째 Google 프로젝트에서 발급) — 실시간 채팅
# RAG와 일일 쿼터를 분리한다(2026-08-28 쿼터 429 실사고 대응). 미설정 시 GEMINI_API_KEY
# 하나로 동작(기존과 동일)하지만, 백필이 쿼터를 소진하면 오후에 채팅 RAG가 죽는다.
GEMINI_BACKFILL_API_KEY=

# gildle 지오코딩 + mova 예매 트랙 영화관 검색(카카오 로컬 API) — REST API 키(KAKAO_CLIENT_ID와 동일 값).
# Kakao Developers 콘솔에서 해당 앱의 카카오맵 사용 설정을 켜야 호출이 허용된다.
# 미설정 시 gildle 가로수 CSV 임포트의 좌표 결측 보완만 스킵됨(경고 로그) — 나머지 기능 무영향.
KAKAO_API_KEY=

# Naver Developers → 내 애플리케이션 → API 설정
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
NAVER_REDIRECT_URI=http://localhost:8000/viewer/oauth/naver/callback

# OAuth 로그인 완료 후 되돌아갈 프론트엔드 주소 (기본값: http://localhost:3000)
# FRONTEND_URL=https://suvisdev.cloud

# 세션 JWT 서명 비밀키 — 반드시 무작위 긴 문자열로 채울 것 (예: python3 -c "import secrets; print(secrets.token_urlsafe(48))")
JWT_SECRET=

# RBAC — 콤마로 구분된 admin 이메일 목록 (OAuth 로그인 email 기준)
ADMIN_EMAILS=

# --- apps/auth 게이트웨이 (RS256, 별도 컨테이너 auth_main.py — 이번 라운드는 실트래픽 미연결) ---
# scripts/generate_jwt_keys.sh 로 키 생성 후 아래 값을 채운다.
# JWT_PRIVATE_KEY_B64는 반드시 suvisdev/.env.auth 전용(커밋 금지) — 이 .env(공유)에는 넣지 않는다.
JWT_PUBLIC_KEY_B64=
JWT_KID=

# apps/auth 전용 OAuth 콜백 경로 — viewer의 GOOGLE_REDIRECT_URI 등과 반드시 다른 값이어야
# 하며, 각 프로바이더 콘솔에 별도로 등록해야 한다(viewer용 기존 URI는 그대로 유지).
AUTH_GOOGLE_REDIRECT_URI=http://localhost:9000/auth/callback/google
AUTH_KAKAO_REDIRECT_URI=http://localhost:9000/auth/callback/kakao
AUTH_NAVER_REDIRECT_URI=http://localhost:9000/auth/callback/naver

# --- 홈 포트폴리오 AI 채팅(/portfolio/chat, 2026-09-27) ---
# 답변 LLM. exaone: 노트북 ollama exaone3.5:7.8b(기본, 실패 시 Gemini 자동 폴백) / gemini: Gemini만.
# 7.8B는 VRAM 5.7GB(num_ctx 8192) — mova lora-server(2.4GB)와 동시 상주 가능하나 2.4B 라우터는 밀려난다.
# mova 지연이 실측되면 PORTFOLIO_LLM_MODEL=exaone3.5:2.4b 또는 PORTFOLIO_LLM_BACKEND=gemini로 전환.
# PORTFOLIO_LLM_BACKEND=exaone
# PORTFOLIO_LLM_MODEL=exaone3.5:7.8b
# PORTFOLIO_LLM_KEEP_ALIVE=5m
# 문서 색인(공개 문서만): python scripts/ingest_portfolio_docs.py datasets/portfolio_corpus <지킬 경로들> --reset

# gildle 앱 최소 지원 버전(GET /api/gildle/app/version) — 강제 업데이트 시 min을 올린다
GILDLE_APP_MIN_VERSION=1.0.0
GILDLE_APP_LATEST_VERSION=1.0.0
GILDLE_APP_STORE_URL=

# mova 채팅 오케스트레이터(2026-09-27) — 발화 이해(EXAONE, Ollama). 0이면 기존 분류기 경로만
MOVA_ORCHESTRATOR_ENABLED=1
MOVA_ORCHESTRATOR_MODEL=exaone3.5:7.8b
MOVA_ORCHESTRATOR_TIMEOUT_S=20
