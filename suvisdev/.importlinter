[importlinter]
root_packages =
    ontology
    titanic
    mova
    viewer
    execsuite
    dispatch
    gildle
    deolmi
    contents
    sample
    analytics
    media
    news
    core
    auth
    shared

# Rule 1: Hub (ontology) must not depend on any spoke.
[importlinter:contract:hub-independence]
name = Hub (ontology) must not depend on any spoke
type = forbidden
source_modules =
    ontology
forbidden_modules =
    titanic
    mova
    viewer
    execsuite
    dispatch
    gildle
    deolmi
    contents
    sample
    analytics
    media
    news
# 아래 예외 (a)(Rule 2 주석 참고)와 동일: ontology가 DB 세션을 위해 core를
# 임포트하고, core.grid_oracle이 테이블 등록을 위해 spoke ORM을 임포트하는
# 간접 사슬. 직접 hub→spoke 임포트가 아니므로 허용.
ignore_imports =
    core.matrix.grid_oracle_database_manager -> dispatch.adapter.outbound.orm
    core.matrix.grid_oracle_database_manager -> mova.adapter.outbound.orm
    core.matrix.grid_oracle_database_manager -> viewer.adapter.outbound.orm.admin_orm
    core.matrix.grid_oracle_database_manager -> viewer.adapter.outbound.orm.group_orm
    core.matrix.grid_oracle_database_manager -> viewer.adapter.outbound.orm.user_orm

# Rule 2: Spokes must not import each other directly (star topology).
[importlinter:contract:spoke-independence]
name = Spokes must not import each other directly (star topology)
type = independence
modules =
    titanic
    mova
    viewer
    execsuite
    dispatch
    gildle
    deolmi
    contents
    sample
    analytics
    media
    news
    auth
# Allowed exceptions (known, documented). Two intentional cross-spoke couplings:
#
# (a) DB metadata registration: core/matrix/grid_oracle_database_manager imports
#     every spoke's ORM so SQLAlchemy registers all tables for create_tables().
#     Since all spokes depend on core, this bridges spokes INDIRECTLY
#     (spoke -> core -> spoke); there is NO direct spoke-to-spoke import here.
#     Revisit by letting each spoke register its own models.
#
# (b) Cross-metadata FK (see apps/mova/_docs/CLAUDE.md B.3): mova chat/picks/
#     reviews/watchlist/mypage tables FK-reference viewer users.id, so they
#     import viewer's User ORM directly. A deliberate shared-User dependency.
#     Revisit via a shared user-reference package.
#
# Remove the matching entries when either coupling is refactored away.
ignore_imports =
    core.matrix.grid_oracle_database_manager -> dispatch.adapter.outbound.orm
    core.matrix.grid_oracle_database_manager -> mova.adapter.outbound.orm
    core.matrix.grid_oracle_database_manager -> viewer.adapter.outbound.orm.admin_orm
    core.matrix.grid_oracle_database_manager -> viewer.adapter.outbound.orm.group_orm
    core.matrix.grid_oracle_database_manager -> viewer.adapter.outbound.orm.user_orm
    mova.adapter.outbound.orm.market_chat_orm -> viewer.adapter.outbound.orm.user_orm
    mova.adapter.outbound.orm.market_picks_orm -> viewer.adapter.outbound.orm.user_orm
    mova.adapter.outbound.orm.market_reviews_orm -> viewer.adapter.outbound.orm.user_orm
    mova.adapter.outbound.orm.market_user_actions_orm -> viewer.adapter.outbound.orm.user_orm
    mova.adapter.outbound.orm.market_watchlist_orm -> viewer.adapter.outbound.orm.user_orm
    mova.adapter.outbound.orm.market_conversations_orm -> viewer.adapter.outbound.orm.user_orm
    mova.adapter.outbound.orm.market_game_scores_orm -> viewer.adapter.outbound.orm.user_orm
    mova.adapter.outbound.orm.market_review_comments_orm -> viewer.adapter.outbound.orm.user_orm
    mova.adapter.outbound.orm.market_review_votes_orm -> viewer.adapter.outbound.orm.user_orm
    mova.adapter.outbound.orm.platform_user_taste_vectors_orm -> viewer.adapter.outbound.orm.user_orm
    mova.adapter.outbound.pg.games_pg_repository -> viewer.adapter.outbound.orm.user_orm
    mova.adapter.inbound.scheduler.editor_reviews_scheduler -> viewer.adapter.outbound.orm.user_orm
    mova.adapter.outbound.pg.market_reviews_pg_repository -> viewer.adapter.outbound.orm.user_orm
    mova.adapter.outbound.pg.mypage_pg_repository -> viewer.adapter.outbound.orm.user_orm
    mova.adapter.outbound.pg.user_preference_pg_repository -> viewer.adapter.outbound.orm.user_orm
    mova.adapter.inbound.api.v1.whoami_router -> viewer.adapter.outbound.orm.user_orm

# Rule 3: 도메인 순수성(헥사고날·클린, suvisdev/CLAUDE.md §C·§P) — 모든 앱의 domain 은 어느 앱의 app·adapter 도
# import 하지 않는다. 와일드카드라 새 앱도 자동으로 걸린다(11-08, 앱별 계약 4개를 하나로 합침).
# news 도메인은 newsdesk 하네스와 같은 코드를 유지하려고 표준 라이브러리만 쓴다(옛 news-domain-purity 주석).
[importlinter:contract:domain-purity]
name = Domain must not import app or adapter (any app)
type = forbidden
source_modules =
    *.domain
forbidden_modules =
    *.app
    *.adapter

# Rule 4: 유스케이스(app)는 outbound 어댑터(DB·LLM·HTTP 구현)를 직접 import 하지 않는다 — 출력 포트(ABC)를 거친다
# (§C.3). inbound 스키마는 §C.2 설계("Schema in")라 허용. 직접 import 만 본다(allow_indirect_imports).
# 아래 예외는 11-08 실측 기존 위반이다. **줄이기만 한다** — 새 항목 추가는 사용자 확인 사항이고, 고치면 지운다.
[importlinter:contract:app-no-outbound]
name = Use cases must not import outbound adapters directly
type = forbidden
source_modules =
    *.app
forbidden_modules =
    *.adapter.outbound
allow_indirect_imports = true
ignore_imports =
    mova.app.use_cases.review_spoiler_backfill_interactor -> mova.adapter.outbound.llm.spoiler_detection
    mova.app.use_cases.review_spoiler_backfill_interactor -> mova.adapter.outbound.pg.market_reviews_pg_repository
    mova.app.use_cases.review_sentiment_backfill_interactor -> ontology.adapter.outbound.resource_adapters.echo_sentiment.echo_sentiment_adapter
    mova.app.use_cases.review_sentiment_backfill_interactor -> mova.adapter.outbound.pg.market_reviews_pg_repository
    mova.app.use_cases.chat_agent -> mova.adapter.outbound.llm.agent_prompt
    mova.app.use_cases.market_chat_booking_interactor -> mova.adapter.outbound.http.kofic_adapter
    mova.app.use_cases.platform_user_taste_vector_interactor -> mova.adapter.outbound.pg.market_reviews_pg_repository
    mova.app.use_cases.platform_user_taste_vector_interactor -> mova.adapter.outbound.pg.platform_user_taste_vectors_pg_repository
    mova.app.use_cases.review_embedding_backfill_interactor -> mova.adapter.outbound.pg.market_reviews_pg_repository

# Rule 5: auth is a parallel-build gateway (see suvisdev/apps/auth/_docs/) not yet
# wired to real traffic. No existing app may depend on it this round — the reverse
# direction (auth -> spoke) is already covered by spoke-independence above.
[importlinter:contract:auth-isolation]
name = auth is not imported by any existing app (parallel-build, not yet wired)
type = forbidden
source_modules =
    contents
    dispatch
    gildle
    deolmi
    mova
    ontology
    sample
    execsuite
    titanic
    viewer
    analytics
    media
    news
forbidden_modules =
    auth

# Rule 6: shared (cross-app token verification only) must stay a leaf dependency —
# every app may import it, it may not import anything back.
[importlinter:contract:shared-independence]
name = shared must not depend on any spoke or auth
type = forbidden
source_modules =
    shared
forbidden_modules =
    contents
    dispatch
    gildle
    deolmi
    mova
    ontology
    sample
    execsuite
    titanic
    viewer
    analytics
    media
    auth
    news